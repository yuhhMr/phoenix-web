/**
 * TypeScript Node 端配置（Vite 配置文件 vite.config.ts）。
 *
 * 本文件解决什么问题：
 * - 让 vite.config.ts 能使用 Node 类型（如 path、process.env 等）；
 * - 使用 nodenext 模块策略，与 Vite 8 + Node 20+ 环境匹配；
 * - 与应用端 tsconfig.app.json 隔离，避免 Node 类型污染浏览器代码。
 *
 * 修改注意点：
 * - 新增 Node 脚本（如 scripts/ 下的 .ts）时，可考虑再建一个 tsconfig.scripts.json；
 * - include 只放 vite.config.ts，不要把 src/ 加进来。
 */
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts"]
}
